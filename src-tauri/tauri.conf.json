{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeQuest",
  "version": "1.0.0",
  "identifier": "com.timequest.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TimeQuest",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "高考倒计时 · 自习推进器",
    "longDescription": "TimeQuest — 高考倒计时 · 自习推进器。本地优先的自学闭环工具。"
  },
  "plugins": {}
}
